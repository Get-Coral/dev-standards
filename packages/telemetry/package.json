{
	"name": "@get-coral/telemetry",
	"version": "0.1.0",
	"description": "Anonymous, opt-out telemetry client for Coral modules and CLIs",
	"keywords": [
		"coral",
		"telemetry",
		"analytics",
		"posthog",
		"opt-out"
	],
	"license": "MIT",
	"author": "ElianCodes <hello@elian.codes>",
	"homepage": "https://getcoral.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Get-Coral/dev-standards.git",
		"directory": "packages/telemetry"
	},
	"bugs": {
		"url": "https://github.com/Get-Coral/dev-standards/issues"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js",
			"require": "./dist/node.cjs"
		},
		"./browser": {
			"types": "./dist/browser.d.ts",
			"import": "./dist/browser.js",
			"require": "./dist/browser.cjs"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "biome check .",
		"prepublishOnly": "pnpm build"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"posthog-js": "^1.399.2",
		"posthog-node": "^5.41.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@types/node": "^24.5.2",
		"tsup": "^8.5.0",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	}
}
