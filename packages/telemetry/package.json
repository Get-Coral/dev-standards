{
	"name": "@get-coral/telemetry",
	"version": "0.1.0",
	"description": "Anonymous, opt-out telemetry client for Coral modules and CLIs",
	"keywords": [
		"analytics",
		"coral",
		"opt-out",
		"posthog",
		"telemetry"
	],
	"homepage": "https://getcoral.dev",
	"bugs": {
		"url": "https://github.com/Get-Coral/dev-standards/issues"
	},
	"license": "MIT",
	"author": "ElianCodes <hello@elian.codes>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Get-Coral/dev-standards.git",
		"directory": "packages/telemetry"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./node": {
			"import": {
				"types": "./dist/node.d.ts",
				"default": "./dist/node.js"
			},
			"require": {
				"types": "./dist/node.d.cts",
				"default": "./dist/node.cjs"
			}
		},
		"./browser": {
			"import": {
				"types": "./dist/browser.d.ts",
				"default": "./dist/browser.js"
			},
			"require": {
				"types": "./dist/browser.d.cts",
				"default": "./dist/browser.cjs"
			}
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch",
		"typecheck": "tsc --noEmit",
		"test": "vp test run",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"posthog-js": "^1.399.2",
		"posthog-node": "^5.45.2"
	},
	"devDependencies": {
		"@types/node": "^24.5.2",
		"typescript": "^5.9.3",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=20"
	}
}
